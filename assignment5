-- 98.Display the top 10 students with the highest marks, using ORDER BY along with a
-- row-limiting clause.

select top 10 * from student
order by marks DESC

/*
Without ORDER BY: SQL Server processes table data in no guaranteed order (often physical storage/insertion order). So TOP 10 simply grabs the first 10 rows it encounters in the table (usually RollNo 1 through 10).
With ORDER BY Marks DESC: SQL Server sorts the entire table first by marks from highest to lowest, and then TOP 10 slices off the highest 10 scores from that sorted list.
*/

-- 99.Display all distinct courses sorted alphabetically.

